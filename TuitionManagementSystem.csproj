<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <RootNamespace>TuitionManagementSystem</RootNamespace>
    <AssemblyName>TuitionManagementSystem</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite database driver -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <!-- PDF report generation (matches Technology Stack in Requirements Summary) -->
    <PackageReference Include="QuestPDF" Version="2024.10.1" />
  </ItemGroup>

</Project>
