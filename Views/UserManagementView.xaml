<UserControl x:Class="TuitionManagementSystem.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TuitionManagementSystem.Helpers">
    <StackPanel>
        <TextBlock Text="USER MANAGEMENT" Style="{StaticResource SectionLabel}"/>
        <TextBlock Text="User Accounts" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="Every login account, including self-registered users. Reset passwords or enable/disable access here."
                   Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <!-- Summary cards -->
        <UniformGrid Columns="2" Rows="1" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total Users" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding TotalUsers}" FontSize="26" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Active Users" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding ActiveUsers}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Reset password mini form, shown only when a user clicks "Reset Password" -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Background="#EFF6FF" BorderBrush="#BFDBFE"
                Visibility="{Binding IsResetFormVisible, Converter={x:Static local:BoolToVisConverter.Instance}}">
            <StackPanel>
                <TextBlock Text="{Binding ResetFormTitle}"
                           FontWeight="Bold" FontSize="13" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="New Password" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource InputPasswordBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Confirm New Password" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="ConfirmNewPasswordBox" Style="{StaticResource InputPasswordBox}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding ResetMessage}" Foreground="{StaticResource DangerRed}" FontSize="11.5" Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Cancel" Style="{StaticResource OutlineButton}" Width="90" Margin="0,0,10,0" Command="{Binding CancelResetCommand}"/>
                    <Button Content="Reset Password" Style="{StaticResource PrimaryButton}" Width="150" Command="{Binding ConfirmResetCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Table of all users -->
        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Users}" Style="{StaticResource SimpleGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedDate}" Width="110"/>
                    <DataGridTemplateColumn Header="Status" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Pill}"
                                        Background="{Binding IsActive, Converter={x:Static local:BoolToActiveBrushConverter.Instance}}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding IsActive, Converter={x:Static local:BoolToActiveTextConverter.Instance}}"
                                               Foreground="{Binding IsActive, Converter={x:Static local:BoolToActiveForegroundConverter.Instance}}"
                                               FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Actions" Width="290">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Reset Password" Style="{StaticResource OutlineButton}" Width="120" Margin="0,0,6,0"
                                            Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Enable/Disable" Style="{StaticResource OutlineButton}" Width="110" Margin="0,0,6,0"
                                            Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Del" Style="{StaticResource DangerButton}" Width="45" Height="34"
                                            Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
