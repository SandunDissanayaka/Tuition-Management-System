<UserControl x:Class="TuitionManagementSystem.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:TuitionManagementSystem.Helpers">
    <StackPanel>
        <TextBlock Text="REPORTS" Style="{StaticResource SectionLabel}"/>
        <TextBlock Text="Reports" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{Binding Grade, StringFormat='{}{0} Mathematics — Generate printable PDF reports and view student attendance history'}"
                   Style="{StaticResource PageSubtitle}" Margin="0,0,0,20"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Pending Fee Report" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                <TextBlock Text="Exports every unpaid or pending fee record for the selected grade and date range as a PDF file."
                           Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="FROM DATE" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding FromDate}" DisplayDateEnd="{x:Static sys:DateTime.Today}" Height="38"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TO DATE" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding ToDate}" DisplayDateEnd="{x:Static sys:DateTime.Today}" Height="38"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                        <Button Content="Export PDF" Style="{StaticResource PrimaryButton}" Command="{Binding ExportPendingFeesPdfCommand}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessGreen}"
                           FontSize="11.5" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===================== ATTENDANCE HISTORY ===================== -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Attendance History" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                <TextBlock Text="Search a student by name or ID to see which lessons they attended and which lessons they missed in a date range."
                           Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="STUDENT NAME OR ID" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="FROM DATE" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding HistoryFromDate}" DisplayDateEnd="{x:Static sys:DateTime.Today}" Height="42"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="TO DATE" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding HistoryToDate}" DisplayDateEnd="{x:Static sys:DateTime.Today}" Height="42"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding HistoryMessage}" Foreground="{StaticResource TextMuted}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,14,0,0"/>

                <!-- Summary counts -->
                <UniformGrid Columns="2" Rows="1" Margin="0,14,0,0"
                             Visibility="{Binding ShowHistoryResults, Converter={x:Static local:BoolToVisConverter.Instance}}">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0" Background="#F0FDF4">
                        <StackPanel>
                            <TextBlock Text="Lessons Attended" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding AttendedCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0,0,0" Background="#FEF2F2">
                        <StackPanel>
                            <TextBlock Text="Lessons Absent" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding AbsentCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DangerRed}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Two lists side by side: attended | absent -->
                <Grid Margin="0,14,0,0"
                      Visibility="{Binding ShowHistoryResults, Converter={x:Static local:BoolToVisConverter.Instance}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ATTENDED -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                        <StackPanel>
                            <Border Background="#DCFCE7" CornerRadius="10,10,0,0" Padding="14,10">
                                <TextBlock Text="Attended Lessons" FontWeight="SemiBold" FontSize="12.5" Foreground="#15803D"/>
                            </Border>
                            <Grid Background="#F8FAFC" Height="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Date" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="Lesson" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock Grid.Column="2" Text="Student" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="8,0"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding AttendedLessons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderGray}" BorderThickness="0,0,0,1">
                                            <Grid MinHeight="38">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DateText}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding LessonName}" FontSize="12" VerticalAlignment="Center" Margin="8,0"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding LessonName}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding StudentName}" FontSize="12" VerticalAlignment="Center" Margin="8,0"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding StudentName}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No attended lessons in this period." Style="{StaticResource PageSubtitle}"
                                       HorizontalAlignment="Center" Margin="0,18"
                                       Visibility="{Binding NoAttendedLessons, Converter={x:Static local:BoolToVisConverter.Instance}}"/>
                        </StackPanel>
                    </Border>

                    <!-- ABSENT -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                        <StackPanel>
                            <Border Background="#FEE2E2" CornerRadius="10,10,0,0" Padding="14,10">
                                <TextBlock Text="Absent Lessons" FontWeight="SemiBold" FontSize="12.5" Foreground="#DC2626"/>
                            </Border>
                            <Grid Background="#F8FAFC" Height="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Date" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="Lesson" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock Grid.Column="2" Text="Student" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="8,0"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding AbsentLessons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderGray}" BorderThickness="0,0,0,1">
                                            <Grid MinHeight="38">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DateText}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding LessonName}" FontSize="12" VerticalAlignment="Center" Margin="8,0"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding LessonName}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding StudentName}" FontSize="12" VerticalAlignment="Center" Margin="8,0"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding StudentName}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No absences in this period." Style="{StaticResource PageSubtitle}"
                                       HorizontalAlignment="Center" Margin="0,18"
                                       Visibility="{Binding NoAbsentLessons, Converter={x:Static local:BoolToVisConverter.Instance}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
