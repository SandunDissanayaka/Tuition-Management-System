<UserControl x:Class="TuitionManagementSystem.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="REPORTS" Style="{StaticResource SectionLabel}"/>
        <TextBlock Text="Reports" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{Binding Grade, StringFormat='{}{0} Mathematics — Generate printable PDF reports for a date range'}"
                   Style="{StaticResource PageSubtitle}" Margin="0,0,0,20"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Pending Fee Report" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                <TextBlock Text="Exports every unpaid or pending fee record for the selected grade and date range as a PDF file."
                           Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="FROM DATE" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding FromDate}" Height="38"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TO DATE" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding ToDate}" Height="38"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                        <Button Content="Export PDF" Style="{StaticResource PrimaryButton}" Command="{Binding ExportPendingFeesPdfCommand}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessGreen}"
                           FontSize="11.5" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Text="More report types (attendance history, term summaries) can be added the same way — "
                   Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,16,0,0"/>
        <TextBlock Text="just add another button here and a matching method in ReportsViewModel.cs."
                   Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
