<UserControl x:Class="TuitionManagementSystem.Views.PendingFeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="PENDING FEES" Style="{StaticResource SectionLabel}"/>
        <TextBlock Text="Pending Fee Students" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{Binding Grade, StringFormat='{}{0} Mathematics — Students with outstanding payments'}"
                   Style="{StaticResource PageSubtitle}" Margin="0,0,0,16"/>

        <!-- Filters -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="GRADE" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding Grade, Mode=OneWay}" IsReadOnly="True"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="FROM DATE" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Height="38"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="TO DATE" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Height="38"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="SEARCH STUDENT" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Summary cards -->
        <UniformGrid Columns="2" Rows="1" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Pending Students" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding PendingStudentsCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource DangerRed}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Total Pending Amount" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding TotalPendingAmount, StringFormat='Rs. {0:N0}'}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource DangerRed}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Table -->
        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding PendingRecords}" Style="{StaticResource SimpleGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding StudentCode}" Width="80"/>
                    <DataGridTextColumn Header="Student Name" Binding="{Binding StudentName}" Width="*"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding SessionDate}" Width="110"/>
                    <DataGridTextColumn Header="Lesson" Binding="{Binding LessonName}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding FeeStatus}" Width="100"/>
                    <DataGridTemplateColumn Header="Action" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Collect" Style="{StaticResource PrimaryButton}" Height="30" Width="80"
                                        Command="{Binding DataContext.CollectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
