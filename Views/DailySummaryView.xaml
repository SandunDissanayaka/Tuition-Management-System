<UserControl x:Class="TuitionManagementSystem.Views.DailySummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid>
            <StackPanel>
                <TextBlock Text="DAILY SUMMARY" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="Daily Summary" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding Grade, StringFormat='{}{0} Mathematics'}" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Button Content="Save Summary" Style="{StaticResource PrimaryButton}" Width="140"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding SaveCommand}"/>
        </Grid>

        <Border Style="{StaticResource Card}" Margin="0,16,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="DATE" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding Date}" Height="38"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="GRADE" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding Grade, Mode=OneWay}" IsReadOnly="True"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="LESSON" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding LessonName, Mode=OneWay}" IsReadOnly="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Columns="3" Rows="1" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total Students" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding TotalStudents}" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="10,0,10,0">
                <StackPanel>
                    <TextBlock Text="Present" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding Present}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Absent" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding Absent}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DangerRed}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <UniformGrid Columns="3" Rows="1" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Paid" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding Paid}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="10,0,10,0">
                <StackPanel>
                    <TextBlock Text="Pending" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding Pending}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DangerRed}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Total Fees Collected" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding TotalFeesCollected, StringFormat='Rs. {0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Text="Daily Expenses &amp; Net Amount" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PRINTING EXPENSE (RS.)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding PrintingExpense, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SPACE/VENUE EXPENSE (RS.)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding VenueExpense, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,18,0,14"/>

                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Total Fees Collected" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding TotalFeesCollected, StringFormat='Rs. {0:N0}'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Printing Expense" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding PrintingExpense, StringFormat='Rs. {0:N0}'}" HorizontalAlignment="Right" Foreground="{StaticResource DangerRed}"/>
                </Grid>
                <Grid Margin="0,0,0,14">
                    <TextBlock Text="Space/Venue Expense" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding VenueExpense, StringFormat='Rs. {0:N0}'}" HorizontalAlignment="Right" Foreground="{StaticResource DangerRed}"/>
                </Grid>
                <Separator Margin="0,0,0,14"/>
                <Grid>
                    <TextBlock Text="Net Daily Amount" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="{Binding NetDailyAmount, StringFormat='Rs. {0:N0}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="{StaticResource DangerRed}"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
