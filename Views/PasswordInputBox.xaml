<UserControl x:Class="TuitionManagementSystem.Views.PasswordInputBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A password field with a show / hide (eye) button on its right side.
         Only one of the two boxes is visible at a time; their text is kept in sync in the code-behind. -->
    <Grid>
        <!-- Hidden mode: dots -->
        <PasswordBox x:Name="HiddenBox" Style="{StaticResource InputPasswordBox}" Padding="12,9,46,9"/>

        <!-- Visible mode: plain text -->
        <TextBox x:Name="VisibleBox" Style="{StaticResource InputBox}" Padding="12,9,46,9" Visibility="Collapsed"/>

        <!-- Eye button. Not focusable, so clicking it never takes the cursor out of the box. -->
        <ToggleButton x:Name="EyeButton" Width="34" Height="30" Margin="0,0,6,0"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Focusable="False" IsTabStop="False" Cursor="Hand"
                      Foreground="{StaticResource TextMuted}"
                      ToolTip="Show password"
                      Click="EyeButton_Click">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                        <Canvas Width="20" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- eye outline -->
                            <Path Data="M1,7 Q10,-3 19,7 Q10,17 1,7 Z"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                            <!-- pupil -->
                            <Ellipse Width="6" Height="6" Canvas.Left="7" Canvas.Top="4"
                                     Fill="{TemplateBinding Foreground}"/>
                            <!-- slash: drawn only while the password is visible -->
                            <Line x:Name="Slash" X1="3" Y1="14" X2="17" Y2="0"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                        </Canvas>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Slash" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
    </Grid>
</UserControl>
