<Window x:Class="TuitionManagementSystem.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jayagath Institute - Login" Height="640" Width="900"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{StaticResource PageBackground}">
    <Grid>
        <!-- Height is NOT fixed here - the card grows to fit its content so nothing
             (like the "Register here" link at the bottom) ever gets clipped. -->
        <Border Width="400" MaxHeight="560" Background="White" CornerRadius="14"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{StaticResource BorderGray}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.12" Color="Black"/>
            </Border.Effect>

            <!-- ScrollViewer is a safety net on smaller screens/resolutions -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,28,30,28">

                    <Border Width="52" Height="52" Background="#E0E7FF" CornerRadius="12" HorizontalAlignment="Center">
                        <TextBlock Text="&#127891;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Jayagath Institute" FontSize="21" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,14,0,2" Foreground="{StaticResource TextDark}"/>
                    <TextBlock Text="Tuition Class Management System" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="Grade 10 &amp; Grade 11 Mathematics" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,22"/>

                    <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UsernameBox" Style="{StaticResource InputBox}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPasswordBox}" Margin="0,0,0,6"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerRed}"
                               FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Button Content="Login" Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}" Margin="0,10,0,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,4">
                        <TextBlock Text="New User?" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                        <Button Content="Register here" Margin="6,0,0,0" Padding="0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Foreground="{StaticResource PrimaryBlue}" FontWeight="SemiBold" FontSize="13"
                                Command="{Binding GoToRegisterCommand}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
