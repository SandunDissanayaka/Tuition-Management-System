<Window x:Class="TuitionManagementSystem.Views.MainDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TuitionManagementSystem.Helpers"
        Title="Jayagath Institute - Dashboard" Height="720" Width="1200"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen" MinHeight="600" MinWidth="1000"
        Background="{StaticResource PageBackground}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ SIDEBAR ============ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarNavy}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,24">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" Background="White" CornerRadius="8" Opacity="0.9">
                            <TextBlock Text="&#127891;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="{Binding InstituteName}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="{Binding Grade, StringFormat='{}{0} Mathematics'}" Foreground="#94A3B8" FontSize="9.5"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Margin="12,10,12,20" Content="&#8618;  Logout"
                        Style="{StaticResource SidebarButton}" Foreground="#FCA5A5" Command="{Binding LogoutCommand}"/>

                <StackPanel Margin="12,0">
                    <Button Content="&#127968;  Home" Command="{Binding ShowHomeCommand}" Margin="0,0,0,4"
                            Style="{Binding ActiveMenu, Converter={x:Static local:MenuStyleConverter.Instance}, ConverterParameter=Home}"/>
                    <Button Content="&#128101;  Students" Command="{Binding ShowStudentsCommand}" Margin="0,0,0,4"
                            Style="{Binding ActiveMenu, Converter={x:Static local:MenuStyleConverter.Instance}, ConverterParameter=Students}"/>
                    <Button Content="&#128203;  Attendance &amp; Fees" Command="{Binding ShowAttendanceFeesCommand}" Margin="0,0,0,4"
                            Style="{Binding ActiveMenu, Converter={x:Static local:MenuStyleConverter.Instance}, ConverterParameter=AttendanceFees}"/>
                    <Button Content="&#9203;  Pending Fees" Command="{Binding ShowPendingFeesCommand}" Margin="0,0,0,4"
                            Style="{Binding ActiveMenu, Converter={x:Static local:MenuStyleConverter.Instance}, ConverterParameter=PendingFees}"/>
                    <Button Content="&#128200;  Daily Summary" Command="{Binding ShowDailySummaryCommand}" Margin="0,0,0,4"
                            Style="{Binding ActiveMenu, Converter={x:Static local:MenuStyleConverter.Instance}, ConverterParameter=DailySummary}"/>
                    <Button Content="&#128196;  Reports" Command="{Binding ShowReportsCommand}" Margin="0,0,0,4"
                            Style="{Binding ActiveMenu, Converter={x:Static local:MenuStyleConverter.Instance}, ConverterParameter=Reports}"/>
                    <Button Content="&#128100;  User Management" Command="{Binding ShowUserManagementCommand}" Margin="0,0,0,4"
                            Visibility="{Binding IsAdmin, Converter={x:Static local:BoolToVisConverter.Instance}}"
                            Style="{Binding ActiveMenu, Converter={x:Static local:MenuStyleConverter.Instance}, ConverterParameter=UserManagement}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ MAIN AREA ============ -->
        <DockPanel Grid.Column="1">
            <!-- Top bar -->
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderGray}" BorderThickness="0,0,0,1" Padding="24,12">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#128197;" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TodayDate}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CurrentUserName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text=" | " FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentUserRole}" FontSize="12" Foreground="{StaticResource PrimaryBlue}" VerticalAlignment="Center"/>
                        <TextBlock Text=" | " FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Grade}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button Content="Change Class" Style="{StaticResource OutlineButton}" Command="{Binding ChangeClassCommand}" Margin="0,0,8,0"/>
                        <Button Content="Logout" Style="{StaticResource OutlineButton}" Foreground="{StaticResource DangerRed}" Command="{Binding LogoutCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page content -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                <ContentControl Content="{Binding CurrentView}" Margin="28"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
