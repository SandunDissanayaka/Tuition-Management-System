<UserControl x:Class="TuitionManagementSystem.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="OVERVIEW DASHBOARD" Style="{StaticResource SectionLabel}"/>
        <TextBlock Text="{Binding HeaderTitle}"
                   Style="{StaticResource PageTitle}" Margin="0,2,0,2"/>
        <TextBlock Text="{Binding HeaderSubtitle}"
                   Style="{StaticResource PageSubtitle}" Margin="0,0,0,20"/>

        <!-- Stat cards -->
        <UniformGrid Columns="5" Rows="1">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total Students" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding TotalStudents}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="Total active roster" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Present Today" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding PresentToday}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,4,0,0"/>
                    <TextBlock Text="Attended session" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Absent Today" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding AbsentToday}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DangerRed}" Margin="0,4,0,0"/>
                    <TextBlock Text="Excused/No show" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Fees Collected" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding FeesCollected, StringFormat='Rs. {0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" Margin="0,4,0,0"/>
                    <TextBlock Text="Daily intake" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Pending Fees" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding PendingFeesAmount, StringFormat='Rs. {0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource WarningAmber}" Margin="0,4,0,0"/>
                    <TextBlock Text="Unsettled" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Today's session sheet -->
        <TextBlock Text="Today's Session Sheet" FontWeight="Bold" FontSize="14" Margin="0,24,0,10"/>
        <Border Style="{StaticResource Card}" Background="#EFF6FF" BorderBrush="#BFDBFE">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{Binding LessonName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryBlue}"/>
                    <TextBlock Text="{Binding TodayDate}" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                </Grid>
                <UniformGrid Columns="3" Rows="1" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="ACADEMIC LESSON" FontSize="9.5" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding LessonName}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="STANDARD SESSION FEE" FontSize="9.5" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding DailyFee, StringFormat='Rs. {0:N0} per student'}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="ENROLLED STUDENT COUNT" FontSize="9.5" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding EnrolledCount, StringFormat='{}{0} Active Students'}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </UniformGrid>
                <Separator Margin="0,14,0,14"/>
                <UniformGrid Columns="3" Rows="1">
                    <StackPanel>
                        <TextBlock Text="PRESENT COUNT" FontSize="9.5" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding PresentToday, StringFormat='● {0} Present Today'}" Foreground="{StaticResource SuccessGreen}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="ABSENT COUNT" FontSize="9.5" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding AbsentToday, StringFormat='● {0} Absent Today'}" Foreground="{StaticResource DangerRed}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="TOTAL COLLECTION INTAKE" FontSize="9.5" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding FeesCollected, StringFormat='Rs. {0:N0}'}" Foreground="{StaticResource SuccessGreen}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
