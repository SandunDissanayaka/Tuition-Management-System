<UserControl x:Class="TuitionManagementSystem.Views.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TuitionManagementSystem.Helpers">
    <StackPanel>
        <Grid Margin="0,0,0,4">
            <StackPanel>
                <TextBlock Text="STUDENT MANAGEMENT" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="Student Records" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding Grade, StringFormat='{}{0} Mathematics'}" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Button Content="+ Add New Student" Style="{StaticResource PrimaryButton}" Width="170"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding AddNewCommand}"
                    Visibility="{Binding IsAdmin, Converter={x:Static local:BoolToVisConverter.Instance}}"/>
        </Grid>

        <!-- Add / Edit form -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                Visibility="{Binding IsFormVisible, Converter={x:Static local:BoolToVisConverter.Instance}}">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Full Name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                        <TextBlock Text="School" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding School, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Parent / Guardian" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding ParentGuardian, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                        <TextBlock Text="Contact Number" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding Contact, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Cancel" Style="{StaticResource OutlineButton}" Width="90" Margin="0,0,10,0" Command="{Binding CancelCommand}"/>
                    <Button Content="Save Student" Style="{StaticResource PrimaryButton}" Width="130" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Search -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,16">
            <StackPanel>
                <TextBlock Text="Search Student Profile" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                <TextBox Style="{StaticResource InputBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Search by name or student ID..."/>
            </StackPanel>
        </Border>

        <!-- Table -->
        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Students}" Style="{StaticResource SimpleGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding StudentCode}" Width="80"/>
                    <DataGridTextColumn Header="Student Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="School" Binding="{Binding School}" Width="*"/>
                    <DataGridTextColumn Header="Parent/Guardian" Binding="{Binding ParentGuardian}" Width="*"/>
                    <DataGridTextColumn Header="Contact" Binding="{Binding Contact}" Width="130"/>
                    <DataGridTemplateColumn Header="Actions" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static local:BoolToVisConverter.Instance}}">
                                        <Button Content="Edit" Style="{StaticResource OutlineButton}" Width="55" Margin="0,0,6,0"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Del" Style="{StaticResource DangerButton}" Width="45" Height="34"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <TextBlock Text="View only" FontSize="11" FontStyle="Italic"
                                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                                               Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static local:InverseBoolToVisConverter.Instance}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
