<UserControl x:Class="TuitionManagementSystem.Views.AttendanceFeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:TuitionManagementSystem.Helpers">
    <StackPanel>
        <Grid>
            <StackPanel>
                <TextBlock Text="ATTENDANCE &amp; FEES" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="Daily Attendance &amp; Fee Checklist" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding Grade, StringFormat='{}{0} Mathematics — Mark attendance and fee status for each student'}"
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Button Content="Save Checklist" Style="{StaticResource PrimaryButton}" Width="150"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding SaveCommand}"/>
        </Grid>

        <Border Style="{StaticResource Card}" Margin="0,16,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="GRADE" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding Grade, Mode=OneWay}" IsReadOnly="True"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="DATE" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding SessionDate}" Height="38"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="LESSON NAME" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding LessonName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="DAILY FEE (RS.)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding DailyFee, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="Student Attendance" FontWeight="Bold" FontSize="14"/>
        <TextBlock Text="Select attendance and fee status for each student. Nothing is pre-selected — pick 'Present' or 'Absent' for each student, then Save."
                   Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Border Style="{StaticResource Card}" Padding="0">
            <StackPanel>
                <!-- Header row -->
                <Grid Background="#F8FAFC" Height="42">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ID" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="16,0"/>
                    <TextBlock Grid.Column="1" Text="Student Name" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock Grid.Column="2" Text="Attendance" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock Grid.Column="3" Text="Fee Status" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock Grid.Column="4" Text="Amount" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="8,0"/>
                </Grid>

                <!-- Rows: a plain ItemsControl, NOT a DataGrid - a DataGrid's cell-selection
                     layer swallows the first click on an embedded ComboBox, which was why
                     selections weren't reliably updating. An ItemsControl has no such layer,
                     so every click reaches the ComboBox directly on the first try. -->
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderGray}" BorderThickness="0,0,0,1">
                                <Grid MinHeight="56">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding StudentCode}" VerticalAlignment="Center" Margin="16,0" FontSize="12.5"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StudentName}" VerticalAlignment="Center" Margin="8,0" FontSize="12.5"/>

                                    <ComboBox Grid.Column="2" SelectedItem="{Binding Attendance}" Height="34"
                                              VerticalAlignment="Center" Margin="8,0,12,0">
                                        <ComboBox.ItemsSource>
                                            <x:Array Type="sys:String">
                                                <sys:String>Not Marked</sys:String>
                                                <sys:String>Present</sys:String>
                                                <sys:String>Absent</sys:String>
                                            </x:Array>
                                        </ComboBox.ItemsSource>
                                    </ComboBox>

                                    <ComboBox Grid.Column="3" SelectedItem="{Binding FeeStatus}" Height="34"
                                              VerticalAlignment="Center" Margin="8,0,12,0">
                                        <ComboBox.ItemsSource>
                                            <x:Array Type="sys:String">
                                                <sys:String>Paid</sys:String>
                                                <sys:String>Pending</sys:String>
                                                <sys:String>Unpaid</sys:String>
                                            </x:Array>
                                        </ComboBox.ItemsSource>
                                    </ComboBox>

                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="{Binding Amount, StringFormat='Rs. {0:N0}'}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Pending" FontSize="10" Foreground="{StaticResource WarningAmber}"
                                                   Visibility="{Binding IsPending, Converter={x:Static local:BoolToVisConverter.Instance}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
